# Runtime configuration
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///quant_trading.db
LIVE_TRADING_ENABLED=false
COMMISSION_RATE=0.001
MAX_TRADE_AMOUNT=1000
MAX_TOTAL_POSITION_RATIO=0.80
MAX_SINGLE_POSITION_RATIO=0.50
NEWS_FRESH_THRESHOLD_SECONDS=3600
NEWS_STALE_THRESHOLD_SECONDS=86400
MARKET_FRESH_THRESHOLD_SECONDS=300
MARKET_STALE_THRESHOLD_SECONDS=86400
NEWS_REFRESH_INTERVAL_MINUTES=15
